{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start All Services",
      "dependsOn": [
        "Start Gateway Service",
        "Start User Service",
        "Start Content Service",
        "Start Message Service",
        "Start Chatbot Service"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Gateway Service",
      "type": "shell",
      "command": "air",
      "args": ["-c", "config/.air/.air-gateway.toml"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "icon": {
        "id": "globe",
        "color": "terminal.ansiBlue"
      },
      "problemMatcher": {
        "owner": "go",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "building...",
          "endsPattern": "running..."
        }
      }
    },
    {
      "label": "Start User Service",
      "type": "shell",
      "command": "air",
      "args": ["-c", "config/.air/.air-user.toml"],
